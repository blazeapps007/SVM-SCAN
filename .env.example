# Read by docker-compose.yml only (variable substitution) — copy to .env next
# to it. The API's own settings live in apps/api/.env, not here.

# Root user for the bundled MongoDB. Only applied on the first start, while
# the mongo_data volume is empty — changing it later does nothing; change the
# user inside MongoDB instead. Must match MONGODB_URI in apps/api/.env
# (percent-encoded there if it has special characters, raw here).
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=<db_password>

# Optional host ports, both bound to 127.0.0.1 only.
# HOST_PORT=85
# MONGO_HOST_PORT=27017
