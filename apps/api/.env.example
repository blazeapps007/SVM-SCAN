MONGODB_URI="mongodb+srv://<db_username>:<db_password>@cluster0.sljmo4s.mongodb.net/dexplorer?retryWrites=true&w=majority&appName=Cluster0"
RPC_ADDRESS="https://rpc.cosmos.nodestake.org"
# Optional: backup RPC nodes, tried in order after RPC_ADDRESS whenever the
# indexer (re)connects, in case the primary is unreachable at that moment.
# RPC_ADDRESS_BACKUP_1="https://rpc2.example.com"
# RPC_ADDRESS_BACKUP_2="https://rpc3.example.com"
CHAIN_NAME="Cosmos Hub"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
BACKFILL_BATCH_SIZE=25
BACKFILL_CONCURRENCY=5
VALIDATOR_REFRESH_INTERVAL_MS=60000
PARAMS_REFRESH_INTERVAL_MS=600000
PROPOSAL_REFRESH_INTERVAL_MS=60000
# How long a single chain RPC query may hang before it's treated as failed
# (the underlying connection retries forever on its own, but individual
# queries have no timeout otherwise — see apps/api/src/chain/withTimeout.ts).
CHAIN_QUERY_TIMEOUT_MS=10000
# Optional: this chain's own EVM JSON-RPC endpoint, used to decode
# MsgEthereumTx transactions (method/token-transfer detail).
EVM_RPC_URL="https://evmd.steemscanner.com"
# Optional: Blockscout-compatible EVM explorer base URL, used only for a
# "view full trace" deep link (not a data source).
EVM_EXPLORER_API_URL="https://evmscan.steemscanner.com"
# Optional: this chain's LCD/REST (port 1317) base URL, used to poll the
# custom steembridge module (Steem/SBD bridge deposits + oracle attestations).
# Bridge Deposits feature is unavailable when unset.
# STEEMBRIDGE_LCD_URL="https://reststeemvmd.steemscanner.com"
BRIDGE_DEPOSIT_REFRESH_INTERVAL_MS=30000
# Not for local dev — the Dockerfile sets this automatically so the API
# server also serves the built frontend (apps/web/dist) from the same port.
# STATIC_DIR="/app/apps/web/dist"
